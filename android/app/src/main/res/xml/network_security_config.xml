<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Trust the system CA store for all connections (Android default).
        This config explicitly re-states the default so Chromium/WebView inside
        the GMS ads SDK can complete TLS handshakes on MIUI/POCO devices where
        the default trust store is sometimes not inherited by the dynamite module.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust the system (device) CA store -->
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- AdMob / Google ad-serving domains: trust system CAs -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">googlesyndication.com</domain>
        <domain includeSubdomains="true">doubleclick.net</domain>
        <domain includeSubdomains="true">googleads.g.doubleclick.net</domain>
        <domain includeSubdomains="true">google.com</domain>
        <domain includeSubdomains="true">gstatic.com</domain>
        <domain includeSubdomains="true">admob.com</domain>
        <domain includeSubdomains="true">googleadservices.com</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
